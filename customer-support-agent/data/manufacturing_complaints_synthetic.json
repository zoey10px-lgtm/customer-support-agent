  "response_policies": [
    {
      "id": "POL-001",
      "name": "접수 및 정보 확인",
      "rules": [
        "고객사·품번·LOT·납품 수량·불량 수량·증상·사진을 확인한다.",
        "제공되지 않은 사진·측정값·수량을 만들어 답변하지 않는다.",
        "고객 제보는 고객 주장으로, 검사 기록은 기록된 검사 범위로 구분한다."
      ]
    },
    {
      "id": "POL-002",
      "name": "초기 대응",
      "rules": [
        "가상 업무일 기준 1일 이내에 접수 회신 초안을 준비한다.",
        "불량 의심품의 분리 보관을 요청하고 관련 LOT 재고 확인을 담당자에게 제안한다.",
        "교환·회수·재검사는 담당자 승인 후 진행하며 초안에서 승인 전 확정 약속을 하지 않는다."
      ]
    },
    {
      "id": "POL-003",
      "name": "원인 및 재발 방지",
      "rules": [
        "유사 사례의 원인은 조사 후보로만 제시한다.",
        "신규 불만의 원인은 추가 확인 전 조사 중으로 표현한다.",
        "원인 후보마다 확인할 자료와 조사 행동을 함께 제시한다.",
        "회신에 근거 자료 ID를 포함하고 담당자가 확인·수정한 뒤 발송한다."
      ]
    },
    {
      "id": "POL-004",
      "name": "심각도 분류",
      "levels": [
        {
          "level": "high",
          "criterion": "안전 관련 증상 또는 고객 생산·조립 중단이 명시됨"
        },
        {
          "level": "medium",
          "criterion": "불량으로 교환·재검사가 필요하며 생산 중단은 명시되지 않음"
        },
        {
          "level": "low",
          "criterion": "불량 확인 전 단순 품질 문의"
        }
      ]
    }
  ],
